{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null && data.child('players').child(auth.uid).exists()",
        ".write": "auth != null && ((!data.exists() && newData.child('hostId').val() === auth.uid) || data.child('hostId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['hostId', 'phase', 'players'])",
        "phase": {
          ".read": "auth != null"
        },
        "players": {
          ".read": "auth != null",
          "$player": {
            ".write": "auth != null && auth.uid === $player && (root.child('rooms').child($room).child('phase').val() === 'lobby' || data.exists())"
          }
        },
        "answers": {
          "$player": {
            ".write": "auth != null && auth.uid === $player && root.child('rooms').child($room).child('phase').val() === 'answering' && !data.exists()",
            ".validate": "newData.hasChildren(['text', 'createdAt']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 240 && newData.child('createdAt').isNumber()"
          }
        },
        "twists": {
          "$player": {
            ".write": "auth != null && auth.uid === $player && root.child('rooms').child($room).child('phase').val() === 'rewriting' && !data.exists()",
            ".validate": "newData.hasChildren(['text', 'createdAt']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 240 && newData.child('createdAt').isNumber()"
          }
        },
        "votes": {
          "$player": {
            ".write": "auth != null && auth.uid === $player && root.child('rooms').child($room).child('phase').val() === 'voting' && !data.exists() && newData.isString() && newData.val() !== auth.uid && root.child('rooms').child($room).child('twists').child(newData.val()).exists()"
          }
        }
      }
    }
  }
}